# backoffice-dashboard — Vite build/runtime env. `cp .env.example .env` for local dev.
# Only VITE_* vars reach the browser bundle.

# API base. Default "/api" (nginx proxy in compose; vite proxy in `npm run dev`).
# VITE_API_BASE_URL=/api

# ── Error tracking (Phase 15) ──────────────────────────────────────────────
# Unset → Sentry is a no-op. The DSN is a public value (safe in the bundle).
# VITE_SENTRY_DSN=https://xxxx@oNNN.ingest.sentry.io/NNN
# VITE_SENTRY_ENVIRONMENT=          # defaults to the Vite mode
# VITE_SENTRY_RELEASE=              # set by CI to the release name
# VITE_SENTRY_TRACES_SAMPLE_RATE=0  # perf tracing; stays 0 until Phase 16

# CI-only (source-map upload; never in .env): SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
